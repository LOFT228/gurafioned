# ============================================================
# RouteGuardian — environment variables
# Copy to `.env` at the repo root and fill in your values.
# ============================================================

# --- Zerion ---
# Get a free API key at https://dashboard.zerion.io
ZERION_API_KEY=zk_dev_your_key_here

# Name of the wallet you created via `zerion wallet create --name <name>`.
# This is the wallet RouteGuardian will sign transactions from.
ZERION_WALLET_NAME=routeguardian-bot

# Names of the agent tokens (one per policy tier). Created by scripts/setup-zerion.sh.
ZERION_AGENT_TOKEN_SMALL=rg-small
ZERION_AGENT_TOKEN_MEDIUM=rg-medium
ZERION_AGENT_TOKEN_LARGE=rg-large

# --- Backend ---
PORT=4000
NODE_ENV=development
DATABASE_URL="file:./prisma/dev.db"

# Comma-separated allowlist of route sources. Currently supported: jupiter,titan
ROUTE_SOURCES=jupiter,titan

# Per-source quote timeout in milliseconds.
ROUTE_SOURCE_TIMEOUT_MS=1500

# --- Jupiter (no key needed for the lite endpoint) ---
JUPITER_QUOTE_URL=https://lite-api.jup.ag/swap/v1/quote

# --- Titan (optional — leave blank to disable) ---
# TITAN_API_URL=https://api.titandex.io/v1/quote
# TITAN_API_KEY=

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- Demo overrides (optional) ---
# When set, overrides the USD threshold for the large-trade policy so it can
# trigger on small demo amounts. Keep unset in production.
# DEMO_LARGE_TIER_USD_OVERRIDE=20
